# Environment: development | production
ENV=development

# HTTP server
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=20s
SERVER_IDLE_TIMEOUT=90s
SHUTDOWN_TIMEOUT=15s
# Trusted reverse proxies in front of the service. 0 trusts only the connection's
# remote address; behind Azure Container Apps ingress set 1 so the client IP is
# read from X-Forwarded-For.
TRUSTED_PROXY_DEPTH=0

# LinkedIn session credentials (REQUIRED in production).
# Obtain by signing in to LinkedIn in a browser and copying the li_at and
# JSESSIONID cookie values from your session. These are secrets: never commit them.
LINKEDIN_LI_AT=your_li_at_cookie_value
LINKEDIN_JSESSIONID=ajax:your_jsessionid_value

# LinkedIn upstream tuning (safe defaults provided)
LINKEDIN_BASE_URL=https://www.linkedin.com
# REQUIRED when LINKEDIN_LI_AT is set. Must be the EXACT User-Agent of the browser
# where you obtained the li_at and JSESSIONID cookies. A mismatch is the most common
# cause of the session being challenged and invalidated after the first request.
# Copy it from that browser's devtools Network tab (request headers).
LINKEDIN_USER_AGENT=
# Accept-Language a browser sends; part of the session context.
LINKEDIN_ACCEPT_LANGUAGE=en-US,en;q=0.9
HTTP_REQUEST_TIMEOUT=10s
HTTP_MAX_RETRIES=2
HTTP_RETRY_BACKOFF=300ms
PROFILE_TIMEOUT=15s

# Optional profile sections fetched after the core profile, and how many are
# fetched concurrently. Allowed sections: experience, education, skills,
# certifications, languages, volunteer, projects, test_scores.
PROFILE_SECTIONS=experience,education
ENRICHMENT_CONCURRENCY=4

# Optional per-request caller session: when true, a caller may supply its own
# li_at and JSESSIONID through the X-LinkedIn-Li-At and X-LinkedIn-JSESSIONID
# headers. That request then uses only the caller session, never the server one.
LINKEDIN_ALLOW_CALLER_SESSION=true

# In-memory profile cache
CACHE_ENABLED=true
CACHE_TTL=10m
CACHE_MAX_ENTRIES=1000

# Public API rate limiting per client IP
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10

# Upstream protection: caps and circuit breaker in front of LinkedIn
UPSTREAM_MAX_CONCURRENCY=4
UPSTREAM_RATE_RPS=5
UPSTREAM_RATE_BURST=10
UPSTREAM_BREAKER_THRESHOLD=5
UPSTREAM_BREAKER_COOLDOWN=30s
UPSTREAM_SESSION_THRESHOLD=2
UPSTREAM_SESSION_COOLDOWN=5m
# How long a caller session that LinkedIn rejected is fast-failed before it may be tried again
CALLER_SESSION_UNHEALTHY_TTL=5m
UPSTREAM_NEG_CACHE_TTL=1m

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Observability: Prometheus metrics at GET /metrics
METRICS_ENABLED=true

# Request auditing: durable, privacy-safe request history (no secrets stored)
AUDIT_ENABLED=true
AUDIT_DB_PATH=audit.db
AUDIT_RETENTION=720h
AUDIT_BUFFER_SIZE=4096
AUDIT_BATCH_SIZE=128
AUDIT_FLUSH_INTERVAL=1s
# Comma-separated admin keys for GET /admin/usage; empty disables the endpoint
AUDIT_ADMIN_KEYS=
